files:
  "/etc/nginx/conf.d/elasticbeanstalk/laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      location / {
          root /var/app/current/public;
          index  index.php index.html index.htm;
          try_files $uri $uri/ /index.php?$query_string;
      }

container_commands:
  01_reload_nginx:
    command: "sudo systemctl reload nginx"
